<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!--
    Controls how Microsoft.Playwright.NUnit launches the browser for every
    test in this project. Use with:
      dotnet test -s playwright.runsettings
    Override BrowserName on the command line to run the same suite against
    a different engine without editing this file, e.g.:
      dotnet test -s playwright.runsettings -- Playwright.BrowserName=firefox
  -->
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>5000</ExpectTimeout>
    <LaunchOptions>
      <Headless>true</Headless>
      <SlowMo>0</SlowMo>
    </LaunchOptions>
  </Playwright>

  <NUnit>
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
  </NUnit>

  <RunConfiguration>
    <EnvironmentVariables>
      <!-- Uncomment to see the browser window while debugging locally -->
      <!-- <HEADED>1</HEADED> -->
    </EnvironmentVariables>
  </RunConfiguration>
</RunSettings>
